# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[hub]
        protocol = https
[alias]
        co = checkout
        promote = !$DOTFILES/bin/git-promote
        wtf     = !$DOTFILES/bin/git-wtf
        rank-contributors = !$DOTFILES/bin/git-rank-contributors
        count   = !git shortlog -sn
        pr      = "!f() { \
                    BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD); \
                    git push -u origin $BRANCH_NAME; \
                    hub pull-request; \
                  };f "
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
	excludesfile = /Users/lidan/.gitignore
        editor = vim
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
        default = simple
[branch]
        autosetuprebase = always
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /private/var/folders/82/zbc78p1j1m94_ny77t40c9v00000gn/T/AppTranslocation/B2C532DB-A365-4334-B8CE-D277B6279079/d/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[user]
	name = Lidan Hifi
	email = euroil@gmail.com
[commit]
	template = /Users/lidan/.stCommitMsg
[pull]
	rebase = true
[rebase]
	autostash = true
[init]
	defaultBranch = master
[credential]
	helper = osxkeychain

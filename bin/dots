#!/bin/bash
set -euo pipefail
source_path=${BASH_SOURCE[0]}
while [ -L "$source_path" ]; do
  source_dir=$(cd -P "$(dirname "$source_path")" && pwd)
  source_path=$(readlink "$source_path")
  case "$source_path" in /*) ;; *) source_path="$source_dir/$source_path" ;; esac
done
root=$(cd -P "$(dirname "$source_path")/.." && pwd)
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
case "${1:-help}" in
  help|--help|-h)
    cat <<'HELP'
dots — manage this Mac

  setup                Install and configure a machine
  apply                Apply configuration changes
  sync                 Pull, install, remove retired packages and apply
  check                Show what needs attention
  update               Update packages with live output

  add <package>        Install, save to the selected scope, commit and push
  remove <package>     Uninstall, remove declarations, commit and push
  github               Connect GitHub and this machine's SSH key

Examples
  dots add jq
  dots add brew-cask:firefox --scope shared
  dots remove firefox
  dots sync --dry-run
  dots check --verbose

--dry-run previews add/remove/sync/update/apply/setup.
--verbose shows command details (and full diagnostics for check).
The machine profile is remembered from bootstrap.sh.
HELP
    exit 0 ;;
  add) task=pkg:add ;;
  remove) task=pkg:remove ;;
  sync) task=machine:sync ;;
  check) task=machine:check ;;
  update) task=machine:update ;;
  apply) task=machine:apply ;;
  setup) task=machine:setup ;;
  github) task=github:setup ;;
  *) echo "Unknown dots command: $1" >&2; exit 2 ;;
esac
shift
[ -f "$root/.dots-profile" ] || { echo 'Run ./bootstrap.sh Personal or Wonderful once.' >&2; exit 1; }
profile=$(cat "$root/.dots-profile")
case "$profile" in Personal|Wonderful) ;; *) echo 'Invalid machine profile.' >&2; exit 1 ;; esac
command -v mise >/dev/null || { echo 'mise is missing. Run bootstrap.sh.' >&2; exit 1; }
export MISE_AUTO_INSTALL=false
export MISE_TASK_RUN_AUTO_INSTALL=false
exec mise -C "$root" -E "$profile" run "$task" -- "$@"
